			"name": "1. GET /events (Consulter tous les événements)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code attendu : 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Réponse contient une liste d'événements\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/events",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"events"
					]
				},
				"description": "Consulter l'ensemble des événements disponibles avec calcul des places restantes."
			},
			"response": []
		},
